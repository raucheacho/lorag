# Lorag Configuration Example
# Copy this file to .env and modify as needed

# Server Configuration
LORAG_HOST=localhost
LORAG_PORT=8080

# Data Directory
LORAG_DATA_DIR=./data

# Embedding Configuration
LORAG_EMBEDDING_PROVIDER=ollama
LORAG_EMBEDDING_MODEL=nomic-embed-text
LORAG_EMBEDDING_URL=http://localhost:11434
LORAG_EMBEDDING_DIM=768

# Vector Index Configuration
LORAG_VECTOR_INDEX=hnsw
LORAG_VECTOR_M=16
LORAG_VECTOR_EF=200

# Indexing Configuration
LORAG_MAX_CHUNKS=50000
LORAG_CHUNK_SIZE=512
LORAG_CHUNK_OVERLAP=50

# OCR Configuration
LORAG_OCR_ENABLED=false

# Security Configuration
LORAG_ENCRYPTION=false
LORAG_ENCRYPTION_KEY=

# License
LORAG_LICENSE_KEY=
